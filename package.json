{
  "name": "dsh-opencode-cli-bridge",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: bridge DSH to OpenCode-compatible models via the local OpenCode CLI (native LlmAdapter).",
  "type": "module",
  "author": "home-river",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node scripts/build-client.mjs && node --test test/unit/*.test.mjs",
    "test:integration": "tsc -p tsconfig.json && node --test test/integration/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm-adapter",
    "opencode",
    "streaming"
  ],
  "license": "MIT"
}
