{
  "name": "@home-river/dsh-opencode-bridge",
  "version": "0.1.0",
  "description": "A minimal DSH native LLM adapter that connects DSH to OpenCode-compatible streaming endpoints.",
  "type": "module",
  "private": true,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm-adapter",
    "opencode",
    "streaming"
  ],
  "license": "MIT"
}
